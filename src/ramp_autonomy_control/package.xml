<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ramp_autonomy_control</name>
  <version>0.1.0</version>
  <description>Stability margin and wheel-slip monitoring, plus descent braking control.</description>
  <maintainer email="kunal780954@gmail.com">Kunal Yadav</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>
  <exec_depend>ramp_autonomy_nav</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
